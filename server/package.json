{
  "name": "walletwise-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Aura backend: Groq LLM agent with WalletWise engine tools and card knowledge search (RAG).",
  "scripts": {
    "start": "node --env-file-if-exists=../.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ../scripts/register-ts.mjs src/index.ts",
    "ingest": "node --env-file-if-exists=../.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ../scripts/register-ts.mjs src/rag/ingest.ts",
    "chroma": "node scripts/run-chroma.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ../scripts/register-ts.mjs --test \"src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "chromadb": "^3.5.0",
    "groq-sdk": "^1.6.0"
  }
}
