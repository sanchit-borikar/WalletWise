# ── App (read by Expo; values starting EXPO_PUBLIC_ end up in the app bundle) ──
EXPO_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here
# Aura server address. Leave empty during development: the app uses the computer
# running Expo, port 8787. Set it when the server runs somewhere else.
EXPO_PUBLIC_AURA_API_URL=

# ── Aura server (read only by server/, never sent to the app) ──
GROQ_API_KEY=your_groq_api_key_here
# Any Groq chat model that supports tool calling, e.g. openai/gpt-oss-120b or llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-120b
# LLM_PROVIDER=groq
# Embeddings for card search: "local" (default, runs on this computer) or "gemini"
# (Google AI Studio key; used on Vercel, see server/DEPLOY.md).
# EMBEDDINGS_PROVIDER=local
# EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2
# GEMINI_API_KEY=your_gemini_key_here
# Vector store: "chroma" (default, falls back to the index file) or "file" (index file only).
# VECTOR_STORE=chroma
# CHROMA_HOST=localhost
# CHROMA_PORT=8000
# RAG_MIN_SCORE=0.35
# AURA_PORT=8787

# ── App builds (read by app.config.ts) ──
# Google Maps key for the Android map. Without it the map tab shows a list instead.
# GOOGLE_MAPS_ANDROID_API_KEY=
